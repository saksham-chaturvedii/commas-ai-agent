# Server-only secrets — never read from browser code, never commit a real .env file.
#
# LLM provider priority (server/app.ts): ANTHROPIC_API_KEY (if set) > OPENROUTER_KEY (if set) >
# GEMINI_API_KEY (if set) > StubLlmClient. Only one is needed — set at most one, or none for the
# free stub default.

# Optional, and NOT free — the Anthropic API is pay-per-token with no free tier (a key with a
# $0 credit balance will authenticate fine but every real request fails with a billing error).
# Get one at console.anthropic.com and add credits under Plans & Billing before setting this.
ANTHROPIC_API_KEY=

# Optional, and genuinely free — OpenRouter proxies many providers behind one OpenAI-compatible
# API and publishes `:free` model variants at zero cost. This is the primary free option: chosen
# over Gemini after Gemini's real free-tier limit (5 requests/minute for gemini-3.6-flash,
# confirmed live) proved too tight for a multi-step tool-calling investigation in one turn. Get
# a key at openrouter.ai/keys. Used only when ANTHROPIC_API_KEY is unset. See
# server/llm/openrouterClient.ts / server/llm/streaming/openrouterStreamClient.ts.
OPENROUTER_KEY=
# Overrides the default OpenRouter model (nvidia/nemotron-3-super-120b-a12b:free) if you want a different
# free-tier model — check openrouter.ai/models?max_price=0 for currently-available ones.
# Optional.
OPENROUTER_MODEL=

# Optional, and genuinely free — Google AI Studio issues Gemini API keys with a real free tier
# (published rate limits, no credit card required), kept as a secondary free option. Get one at
# aistudio.google.com/apikey. Used only when neither ANTHROPIC_API_KEY nor OPENROUTER_KEY is
# set. See server/llm/geminiClient.ts / server/llm/streaming/geminiStreamClient.ts.
GEMINI_API_KEY=
# Overrides the default Gemini model (gemini-3.6-flash) if that name changes or you want a
# different free-tier model. Optional.
GEMINI_MODEL=

# Without any of the three keys above, the agent runtime falls back to StubLlmClient: a
# deterministic "LLM" that still drives every real MCP tool call, the full multi-source
# investigation, and the approval flow end to end — just with scripted (not model-generated)
# reasoning text. The app is fully functional and completely free with none set. See
# server/llm/stubClient.ts.

# Required in any deployed environment you want gated behind a password (see middleware.ts).
# Compared server-side against the HTTP Basic Auth password on every request — never shipped to
# the client. Leave unset locally to skip the prompt during development.
SITE_PASSWORD=

# Commas MCP connection mode. "mock" (default) runs the in-process mock Commas MCP server
# (server/mcp/mockCommasServer.ts) — no credentials needed, safe for local dev. "real" attempts
# to connect to a live Commas MCP server over Streamable HTTP; requires COMMAS_MCP_URL and
# COMMAS_API_KEY below, and should only ever point at a QA/sandbox environment.
COMMAS_MCP_MODE=mock
COMMAS_MCP_URL=
COMMAS_API_KEY=

PORT=8787

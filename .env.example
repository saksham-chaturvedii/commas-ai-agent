# Server-only secrets — never read from browser code, never commit a real .env file.

# Required for a real (non-stub) LLM. Without this, the agent runtime falls back to a
# deterministic stub "LLM" that still drives real MCP tool calls — see server/llm/stubClient.ts.
ANTHROPIC_API_KEY=

# Commas MCP connection mode. "mock" (default) runs the in-process mock Commas MCP server
# (server/mcp/mockCommasServer.ts) — no credentials needed, safe for local dev. "real" attempts
# to connect to a live Commas MCP server over Streamable HTTP; requires COMMAS_MCP_URL and
# COMMAS_API_KEY below, and should only ever point at a QA/sandbox environment.
COMMAS_MCP_MODE=mock
COMMAS_MCP_URL=
COMMAS_API_KEY=

PORT=8787
